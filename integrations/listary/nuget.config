<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org, so the build does not depend on whatever extra feeds (or
     missing local folders) a machine's user-level NuGet.Config lists. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
